{
  "name": "DTCC Fixed Income Markets",
  "description": "Comprehensive treasury and repo market monitoring dashboard tracking trade volumes by tenor, repo rate spreads, settlement failures, dealer activity, and liquidity conditions across fixed income securities.",
  "img": "https://images.unsplash.com/photo-1611974789855-9c2a0a7236a3?w=400&h=300&fit=crop",
  "allowCustomization": true,
  "tabs": {
    "notes": {
      "id": "notes",
      "name": "Notes",
      "layout": [
        {
          "i": "fixed_income/notes",
          "x": 0,
          "y": 0,
          "w": 40,
          "h": 30
        }
      ]
    },
    "treasury_market": {
      "id": "treasury_market",
      "name": "Treasury Market",
      "layout": [
        {
          "i": "fixed_income/metrics",
          "x": 0,
          "y": 0,
          "w": 40,
          "h": 4
        },
        {
          "i": "fixed_income/treasury_volumes",
          "x": 0,
          "y": 4,
          "w": 20,
          "h": 10
        },
        {
          "i": "fixed_income/repo_spreads",
          "x": 20,
          "y": 4,
          "w": 20,
          "h": 10
        }
      ]
    },
    "repo_market": {
      "id": "repo_market",
      "name": "Repo Market",
      "layout": [
        {
          "i": "fixed_income/dealer_activity",
          "x": 0,
          "y": 0,
          "w": 20,
          "h": 10
        },
        {
          "i": "fixed_income/liquidity_curve",
          "x": 20,
          "y": 0,
          "w": 20,
          "h": 10
        },
        {
          "i": "fixed_income/fails_to_deliver",
          "x": 0,
          "y": 10,
          "w": 40,
          "h": 10
        }
      ]
    }
  },
  "groups": [
    {
      "name": "Time Period Sync",
      "type": "param",
      "paramName": "period",
      "defaultValue": "30d",
      "widgetIds": [
        "fixed_income/treasury_volumes"
      ]
    }
  ],
  "prompts": [
    "What are the current repo rate spreads vs SOFR?",
    "Show me treasury trading volumes by tenor for the last month",
    "Which dealers are the most active in repo markets?",
    "Are there any significant fails-to-deliver issues?",
    "Analyze liquidity conditions across different collateral types"
  ]
}