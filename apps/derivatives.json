{
  "name": "DTCC Derivatives Analytics",
  "description": "Advanced derivatives market analysis dashboard providing insights into swap notionals, CDS spreads, volatility surfaces, net positions, and counterparty networks across OTC derivatives markets.",
  "img": "https://images.unsplash.com/photo-1642790106117-e829e14a795f?w=400&h=300&fit=crop",
  "allowCustomization": true,
  "tabs": {
    "notes": {
      "id": "notes",
      "name": "Notes",
      "layout": [
        {
          "i": "derivatives/notes",
          "x": 0,
          "y": 0,
          "w": 40,
          "h": 30
        }
      ]
    },
    "swaps_credit": {
      "id": "swaps_credit",
      "name": "Swaps & Credit",
      "layout": [
        {
          "i": "derivatives/metrics",
          "x": 0,
          "y": 0,
          "w": 40,
          "h": 4
        },
        {
          "i": "derivatives/swap_notionals",
          "x": 0,
          "y": 4,
          "w": 20,
          "h": 10
        },
        {
          "i": "derivatives/cds_spreads",
          "x": 20,
          "y": 4,
          "w": 20,
          "h": 12
        }
      ]
    },
    "risk_positions": {
      "id": "risk_positions",
      "name": "Risk & Positions",
      "layout": [
        {
          "i": "derivatives/volatility_surface",
          "x": 0,
          "y": 0,
          "w": 20,
          "h": 15
        },
        {
          "i": "derivatives/net_positions",
          "x": 20,
          "y": 0,
          "w": 20,
          "h": 10
        },
        {
          "i": "derivatives/counterparty_network",
          "x": 20,
          "y": 10,
          "w": 20,
          "h": 15
        }
      ]
    }
  },
  "groups": [
    {
      "name": "CDS View Sync",
      "type": "param",
      "paramName": "view",
      "defaultValue": "indices",
      "widgetIds": [
        "derivatives/cds_spreads"
      ]
    }
  ],
  "prompts": [
    "What are the current CDS spreads for major indices?",
    "Show me the implied volatility surface for equity options",
    "Analyze swap notionals by currency and tenor",
    "Which asset classes have the largest net open positions?",
    "Map the derivatives exposure network between major dealers"
  ]
}